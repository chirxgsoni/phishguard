# ==============================================================================
# PhishGuard Backend Environment Variables
# Copy this file to .env and fill in your secrets before starting the server.
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE — Database & Auth (REQUIRED for production)
# ──────────────────────────────────────────────────────────────────────────────
# 1. Go to https://supabase.com/dashboard → Settings → API
# 2. Copy the "Project URL" → SUPABASE_URL
# 3. Copy the "service_role key" (secret) → SUPABASE_KEY
#    ⚠ NEVER use the anon key here. The backend needs service_role to bypass RLS.
# 4. Copy "JWT Secret" (for HS256) or JWKS JSON (for ES256) from Settings → API → JWT Settings
# 5. Run the SQL from sql/schema.sql in the Supabase SQL Editor to create tables
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Or for newer Supabase projects using ES256 asymmetric keys:
SUPABASE_JWKS='{"keys":[{"x":"...","y":"...","alg":"ES256","crv":"P-256","kid":"...","kty":"EC"}]}'

# Symmetric Token Encryption Key (Fernet 32 url-safe base64 bytes)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# LLM (Layer 4 Explainability & SOAR Agent)
# ──────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH (optional — for Gmail inbox scanning)
# ──────────────────────────────────────────────────────────────────────────────
# Create in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connections/callback

# Detection Safety Limits
MAX_REDIRECT_HOPS=5
URL_FETCH_TIMEOUT_SECONDS=5.0
MAX_UPLOAD_SIZE_MB=10
