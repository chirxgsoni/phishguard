# ==============================================================================
# Nexus Frontend Environment Variables
# Copy this file to .env and fill in your Supabase project details.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE — Auth (Frontend uses the ANON key, NOT service_role)
# ──────────────────────────────────────────────────────────────────────────────
# 1. Go to https://supabase.com/dashboard → Settings → API
# 2. Copy the "Project URL" → VITE_SUPABASE_URL
# 3. Copy the "anon public" key → VITE_SUPABASE_ANON_KEY
#    ⚠ This is the PUBLIC key — safe to expose in frontend code.
#    ⚠ NEVER put the service_role key here.
# ──────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND API URL
# ──────────────────────────────────────────────────────────────────────────────
# In development, Vite proxies /api/* and /ws/* to this URL automatically.
# In production (Vercel), set this to your deployed backend URL.
VITE_API_URL=http://localhost:8000
